depends: [
  "dune" {>= "3.11"}
  "ocaml" {>= "4.08"}
  "mtime" {>= "1.4"}
  "opentelemetry" {= version}
  "opentelemetry-client" {= version}
  "odoc" {with-doc}
  "ezcurl" {>= "0.2.3"}
  "ocurl"
  "alcotest" {with-test}
]
build: [
  ["dune" "subst"] {dev}
